# Runtime no Neon: use o endpoint pooled e mantenha TLS habilitado.
DATABASE_URL="postgresql://usuario:senha@ep-projeto-pooler.regiao.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Opcional: endpoint sem `-pooler` para migrations e operações administrativas.
# Se não for informado, a CLI também usa DATABASE_URL.
# DIRECT_URL="postgresql://usuario:senha@ep-projeto.regiao.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Opcional, somente ao criar migrations que precisem de shadow database.
# SHADOW_DATABASE_URL="postgresql://usuario:senha@ep-shadow.regiao.aws.neon.tech/neondb?sslmode=verify-full"

SESSION_TTL_DAYS="30"
AUTH_RATE_LIMIT_MAX="8"
AUTH_RATE_LIMIT_WINDOW_SECONDS="900"
